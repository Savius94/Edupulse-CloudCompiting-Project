# =============================================================================
# Modèle de variables d'environnement — EduPulse SaaS (Docker Swarm)
# =============================================================================
# 1. PROXY RÉSEAU :
# Hors réseau universitaire UPPA (PC maison + VPS Tailscale), laissez vide :
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
no_proxy=

# =============================================================================
# 2. Orchestration Docker Swarm (Manager pur + 2 Workers)
# =============================================================================
NETWORK_DRIVER=overlay
ORCHESTRATOR_MODE=auto
PORTAL_REPLICAS=2
REGISTRY_HOST=100.85.14.115:5000

# =============================================================================
# 3. Paramètres Généraux EduPulse SaaS
# =============================================================================
BASE_DOMAIN=edupulse.mnbll.fr
PUBLIC_PORT=80
SUPERADMIN_EMAIL=superadmin@edupulse.mnbll.fr
SUPERADMIN_PASSWORD=SuperSecretPassword123!

# =============================================================================
# 4. Intégration API Google Gemini (Coaching IA Enseignant)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
