# =============================================================================
# 1. Configuration du Proxy Réseau
# -> Hébergement sur PC/Serveur à domicile + VPS Tailscale : AUCUN proxy sortant
# =============================================================================
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
no_proxy=

# =============================================================================
# 2. Orchestration Docker Swarm (Cluster 3 VMs : Manager + 2 Workers)
# =============================================================================
NETWORK_DRIVER=overlay
ORCHESTRATOR_MODE=auto
PORTAL_REPLICAS=2
REGISTRY_HOST=100.85.14.115:5000

# =============================================================================
# 3. Paramètres Généraux & Domaine EduPulse SaaS (Relais Caddy + Tailscale)
# =============================================================================
BASE_DOMAIN=edupulse.mnbll.fr
PUBLIC_PORT=80
SUPERADMIN_EMAIL=superadmin@edupulse.mnbll.fr
