# =============================================================================
# CONFIGURATION CADDY SUR LE VPS RELAIS (AVEC TAILSCALE)
# =============================================================================
# Architecture Haute Disponibilité (Workers uniquement) :
# - Swarm-Manager (100.85.14.115) : Registry + Docker Socket Proxy + BDDs (0 app web)
# - Swarm-VM1     (100.71.91.21)  : Worker 1 (Traefik :80 + portal-api + tenant-app)
# - Swarm-VM2     (100.83.159.51) : Worker 2 (Traefik :80 + portal-api + tenant-app)
#
# Caddy pointe UNIQUEMENT sur les 2 Workers (100.71.91.21 et 100.83.159.51).
# Si l'un des 2 Workers tombe, Caddy bascule immédiatement tout le trafic sur l'autre !

# 1. Votre application existante
mnbll.fr {
    reverse_proxy 100.116.178.12:8006
}

# 2. EduPulse Portail Principal (HTTPS Let's Encrypt automatique)
edupulse.mnbll.fr {
    reverse_proxy 100.71.91.21:80 100.83.159.51:80 {
        lb_policy round_robin
        fail_duration 5s
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 3. Sous-domaines des Établissements (*.edupulse.mnbll.fr en HTTP sur le port 80)
http://*.edupulse.mnbll.fr {
    reverse_proxy 100.71.91.21:80 100.83.159.51:80 {
        lb_policy round_robin
        fail_duration 5s
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
