# =============================================================================
# CONFIGURATION CADDY SUR LE VPS RELAIS (AVEC TAILSCALE)
# =============================================================================
# Important : Caddy doit pointer UNIQUEMENT vers l'IP Tailscale de VM1 (100.85.14.115:80),
# car c'est sur VM1 que tourne le routeur d'entrée Traefik.
# C'est ensuite Traefik qui répartit la charge sur le réseau Swarm `saas-public-net`.

# 1. Votre application existante
mnbll.fr {
    reverse_proxy 100.116.178.12:8006
}

# 2. EduPulse Portail Principal (HTTPS Let's Encrypt automatique)
edupulse.mnbll.fr {
    reverse_proxy 100.85.14.115:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 3. Sous-domaines des Établissements (*.edupulse.mnbll.fr en HTTP sur le port 80)
http://*.edupulse.mnbll.fr {
    reverse_proxy 100.85.14.115:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
