# =============================================================================
# CONFIGURATION CADDY SUR LE VPS RELAIS (AVEC TAILSCALE) — HAUTE DISPONIBILITÉ
# =============================================================================
# Avec health_uri /ping + dial_timeout 1s + lb_retries 2 :
# - Si un Worker tombe, Caddy détecte sa perte en 1s et réessaie automatiquement
#   la même requête sur le Worker survivant (0 requête perdue !).
# - Active healthcheck /ping toutes les 3s pour exclure le nœud mort du pool.

# 1. Votre application existante
mnbll.fr {
    reverse_proxy 100.116.178.12:8006
}

# 2. EduPulse Portail Principal (HTTPS Let's Encrypt automatique)
edupulse.mnbll.fr {
    reverse_proxy 100.71.91.21:80 100.83.159.51:80 {
        lb_policy round_robin
        lb_try_duration 3s
        lb_try_interval 250ms
        lb_retries 2
        max_fails 1
        fail_duration 15s
        health_uri /ping
        health_interval 3s
        health_timeout 1s
        transport http {
            dial_timeout 1s
        }
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 3. Sous-domaines des Établissements & Portainer (*.edupulse.mnbll.fr en HTTP sur le port 80)
http://*.edupulse.mnbll.fr {
    reverse_proxy 100.71.91.21:80 100.83.159.51:80 {
        lb_policy round_robin
        lb_try_duration 3s
        lb_try_interval 250ms
        lb_retries 2
        max_fails 1
        fail_duration 15s
        health_uri /ping
        health_interval 3s
        health_timeout 1s
        transport http {
            dial_timeout 1s
        }
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
